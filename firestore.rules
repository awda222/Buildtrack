rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 9. Root Announcements (Global Community)
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAnnouncement(request.resource.data);
      allow update: if isSignedIn() && (
        (incoming().authorId == request.auth.uid && isValidAnnouncement(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'dislikes']))
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isBuilder());

      function isValidAnnouncement(data) {
        return data.keys().hasAll(['authorId', 'content'])
          && data.authorId == request.auth.uid
          && data.content is string && data.content.size() <= 2000;
      }

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidReply(request.resource.data);
        allow update: if isSignedIn() && existing().authorId == request.auth.uid && isValidReply(incoming());
        allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isBuilder());

        function isValidReply(data) {
          return data.keys().hasAll(['announcementId', 'authorId', 'content'])
            && data.announcementId == announcementId
            && data.authorId == request.auth.uid
            && data.content is string && data.content.size() <= 1000;
        }
      }
    }

    // 0.1 Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isBuilder() { return isSignedIn() && getUserData().role == 'builder'; }
    function isSupervisor() { return isSignedIn() && getUserData().role == 'supervisor'; }
    function isProjectMember(projectId) { 
        return isSignedIn() && (isBuilder() || isSupervisor()); 
        // In a real multi-user app, we'd check if the user is explicitly added to the project members
    }
    
    function isValidId(id) { 
        return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && isValidUser(incoming());

      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
          && data.uid == request.auth.uid
          && data.role in ['builder', 'supervisor', 'worker']
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
          && data.email is string && data.email.size() <= 256;
      }
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Builders see their projects
      allow create: if isBuilder() && isValidProject(request.resource.data);
      allow update: if isProjectMember(projectId) && isValidProject(incoming());
      allow delete: if isBuilder() && existing().builderId == request.auth.uid;

      function isValidProject(data) {
        return data.keys().hasAll(['name', 'builderId', 'status', 'createdAt'])
          && data.name is string && data.name.size() <= 100
          && data.builderId == request.auth.uid
          && data.status in ['active', 'completed', 'delayed'];
      }

      // 3. Materials Subcollection
      match /materials/{materialId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidMaterial(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidMaterial(incoming());
        allow delete: if isProjectMember(projectId);

        function isValidMaterial(data) {
          return data.keys().hasAll(['projectId', 'name', 'currentStock', 'unit', 'threshold'])
            && data.projectId == projectId
            && data.name is string && data.name.size() <= 100
            && data.currentStock is number
            && data.unit is string && data.unit.size() <= 20
            && data.threshold is number;
        }
      }

      // 4. Attendance Subcollection
      match /attendance/{attendanceId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidAttendance(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidAttendance(incoming());
        allow delete: if isProjectMember(projectId);

        function isValidAttendance(data) {
          return data.keys().hasAll(['projectId', 'workerId', 'date', 'status'])
            && data.projectId == projectId
            && data.status in ['present', 'absent', 'leave']
            && data.date is string && data.date.size() == 10;
        }
      }

      // 5. Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidTask(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidTask(incoming());
        allow delete: if isProjectMember(projectId);

        function isValidTask(data) {
          return data.keys().hasAll(['projectId', 'title', 'status', 'date'])
            && data.projectId == projectId
            && data.title is string && data.title.size() <= 200
            && data.status in ['pending', 'in-progress', 'completed', 'blocked'];
        }
      }

      // 6. Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidExpense(request.resource.data);
        allow update: if isProjectMember(projectId) && isValidExpense(incoming());
        allow delete: if isBuilder() && get(/databases/$(database)/documents/projects/$(projectId)).data.builderId == request.auth.uid;

        function isValidExpense(data) {
          return data.keys().hasAll(['projectId', 'description', 'amount', 'date'])
            && data.projectId == projectId
            && data.amount is number && data.amount >= 0;
        }
      }

      // 7. Announcements Subcollection
      match /announcements/{announcementId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && isValidAnnouncement(request.resource.data);
        allow update: if isProjectMember(projectId) && (
          (incoming().authorId == request.auth.uid && isValidAnnouncement(incoming())) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'dislikes']))
        );
        allow delete: if isProjectMember(projectId) && (existing().authorId == request.auth.uid || isBuilder());

        function isValidAnnouncement(data) {
          return data.keys().hasAll(['projectId', 'authorId', 'content'])
            && data.projectId == projectId
            && data.authorId == request.auth.uid
            && data.content is string && data.content.size() <= 2000;
        }

        // 8. Replies Subcollection
        match /replies/{replyId} {
          allow read: if isProjectMember(projectId);
          allow create: if isProjectMember(projectId) && isValidReply(request.resource.data);
          allow update: if isProjectMember(projectId) && existing().authorId == request.auth.uid && isValidReply(incoming());
          allow delete: if isProjectMember(projectId) && (existing().authorId == request.auth.uid || isBuilder());

          function isValidReply(data) {
            return data.keys().hasAll(['announcementId', 'authorId', 'content'])
              && data.announcementId == announcementId
              && data.authorId == request.auth.uid
              && data.content is string && data.content.size() <= 1000;
          }
        }
      }
    }
  }
}
