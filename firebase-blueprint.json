{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["builder", "supervisor", "worker"] },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Construction project information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "builderId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "delayed"] },
        "phase": { "type": "string" },
        "completion": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "builderId", "status"]
    },
    "Material": {
      "title": "Material",
      "description": "Inventory item for a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "currentStock": { "type": "number" },
        "unit": { "type": "string" },
        "threshold": { "type": "number" },
        "status": { "type": "string", "enum": ["OK", "Low", "Out"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "name", "currentStock", "unit", "threshold"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily worker attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present", "absent", "leave"] },
        "photoUrl": { "type": "string" },
        "dailyWage": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "workerId", "date", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Daily work assignment or progress log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed", "blocked"] },
        "blockedReason": { "type": "string" },
        "photoUrls": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title", "status", "date"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Purchase or payment log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "vendor": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "description", "amount", "date"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Community or team update",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "authorId", "content"]
    }
  },
  "firestore": {
    "users": {
        "schema": "User",
        "description": "User profiles"
    },
    "projects": {
      "schema": "Project",
      "description": "Main project collection"
    },
    "projects/{projectId}/materials": {
      "schema": "Material",
      "description": "Materials inventory for a project"
    },
    "projects/{projectId}/attendance": {
      "schema": "Attendance",
      "description": "Attendance logs for a project"
    },
    "projects/{projectId}/tasks": {
      "schema": "Task",
      "description": "Work tasks and logs for a project"
    },
    "projects/{projectId}/expenses": {
      "schema": "Expense",
      "description": "Expense logs for a project"
    },
    "projects/{projectId}/announcements": {
      "schema": "Announcement",
      "description": "Announcements for a project"
    }
  }
}
